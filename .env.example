# ==============================================================================
# LANDSYNC AI Environment Configuration
# SIH26018 — Smart Automation | Team: Void
#
# IMPORTANT:
# This project uses 100% synthetic demonstration data for hackathon evaluation.
# Never configure real citizen PII or live government registry credentials.
# ==============================================================================

# Database Persistence Layer (SQLAlchemy 2.x + Alembic)
# For local development without Docker, leave empty to automatically fallback to SQLite.
# For Docker Compose / Cloud PostgreSQL + PostGIS:
DATABASE_URL=postgresql+psycopg://landsync:landsync@localhost:5432/landsync

# Storage Provider Architecture (Rule 5 Content-Addressed Evidence Store)
# Options: 'local' (filesystem) | 's3' (AWS S3 or S3-compatible: MinIO, Ceph, R2)
STORAGE_PROVIDER=local
LOCAL_STORAGE_ROOT=.landsync-storage

# Amazon S3 / Object Store (Required only if STORAGE_PROVIDER=s3)
AWS_S3_BUCKET=landsync-evidence-demo
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL=

# Authentication & Access Control (RBAC + Cryptographic JWT)
# Generate a secure key for production: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=landsync-ai-demo-secret-key-change-in-production-1234567890
JWT_EXPIRATION_MINUTES=120

# Document Processing Engine (Pluggable OCR & NER Heuristic Pipeline)
# Options: 'mock' (Deterministic synthetic demo extractions) | 'pdf_text' (pypdf text & regex parser)
DOCUMENT_PROVIDER=mock

# CORS & Networking
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
PORT=8000

# Web Application Frontend (Next.js)
NEXT_PUBLIC_API_URL=http://localhost:8000
